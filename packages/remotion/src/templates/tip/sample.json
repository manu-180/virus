      "startSec": 0,
      "endSec": 2.5,
      "voiceover": "Estás escribiendo useEffect mal. Y ni cuenta te das.",
      "onScreenText": "useEffect\nmal escrito",
      "visualCue": "hook-card-punch",
      "soundEffect": "whoosh"
    },
    {
      "index": 1,
      "role": "setup",
      "startSec": 2.5,
      "endSec": 6,
      "voiceover": "Si no tenés cleanup function, memory leak en producción asegurado.",
      "visualCue": "code-block-typewriter",
      "codeSnippet": {
        "language": "tsx",
        "code": "useEffect(() => {\n  const id = setInterval(tick, 1000);\n}, []);"
      }
    },
    {
      "index": 2,
      "role": "development",
      "startSec": 6,
      "endSec": 13,
      "voiceover": "El fix: retorná una función que cancela el intervalo. React la ejecuta cuando el componente se desmonta.",
      "visualCue": "code-block-typewriter",
      "codeSnippet": {
        "language": "tsx",
        "code": "useEffect(() => {\n  const id = setInterval(tick, 1000);\n  return () => clearInterval(id);\n}, []);"
      },
      "soundEffect": "click"
    },
    {
      "index": 3,
      "role": "mini_payoff",
      "startSec": 13,
      "endSec": 17,
      "voiceover": "La función que retornás del useEffect es el cleanup. Se ejecuta automáticamente.",
      "onScreenText": "return () => cleanup()",
      "visualCue": "highlight-reveal"
    },
    {
      "index": 4,
      "role": "reveal",
      "startSec": 17,
      "endSec": 19.5,
      "voiceover": "Así de simple. Memory leak resuelto.",
      "onScreenText": "Memory leak\nresuelto ✓",
      "visualCue": "hook-card-punch",
      "soundEffect": "ding"
    },
    {
      "index": 5,
      "role": "cta",
      "startSec": 19.5,
      "endSec": 22,
      "voiceover": "Seguime para más tips de React que tu equipo no te va a contar.",
      "visualCue": "cta-card",
      "soundEffect": "pop"
    }
  ],
