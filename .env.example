# ─────────────────────────────────────────────────────────────────────────────
# Virus — Environment variables
#
# Three deploy targets share most of these vars:
#   • Vercel (apps/web)         — public site + API routes
#   • Railway (apps/worker)     — Inngest serve handler
#   • Railway (ig-publisher)    — Instagram publishing FastAPI
#
# Columns below mark which service needs each var:
#   [W]eb   [K]worker   [I]g-publisher
# See DEPLOY.md for the full Inngest Cloud + Railway + Vercel setup.
# ─────────────────────────────────────────────────────────────────────────────

# ─── SUPABASE ───────────────────────────────────────────  [W] [K] [I]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# ─── ANTHROPIC (Claude API) ─────────────────────────────  [W] [K]
ANTHROPIC_API_KEY=

# ─── ELEVENLABS ─────────────────────────────────────────  [K]
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── ASSEMBLYAI (captions) ──────────────────────────────  [K]
ASSEMBLYAI_API_KEY=

# ─── AWS (Remotion Lambda) ──────────────────────────────  [K]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_S3_BUCKET=
REMOTION_SERVE_URL=

# ─── INNGEST ─────────────────────────────────────────────  [W] [K]
# Get both from https://app.inngest.com → your environment → Manage → Event Keys / Signing Key.
# - INNGEST_EVENT_KEY:   used by BOTH web and worker to publish events to Inngest Cloud.
# - INNGEST_SIGNING_KEY: used ONLY by the worker to verify webhooks from Inngest Cloud.
# - INNGEST_WORKER_URL:  optional, web-only. If set, /api/diag/inngest probes
#                        `${INNGEST_WORKER_URL}/health` so the operator can
#                        confirm the worker is reachable from the web.
#                        Example: https://virus-worker-production.up.railway.app
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_WORKER_URL=

# ─── OPS: diagnostics + cron sweep ──────────────────────  [W]
# DIAG_TOKEN:  if set, GET /api/diag/inngest?token=... returns Inngest health.
#              Pick any random ≥32-char string. Leave empty to disable the endpoint.
# CRON_SECRET: if set, GET/POST /api/cron/sweep-stuck-carousels (Bearer or ?token=)
#              is callable by an external scheduler to fail stuck carousels.
#              The web's list endpoint also sweeps on every GET, so this is
#              belt-and-suspenders for background coverage when nobody is browsing.
DIAG_TOKEN=
CRON_SECRET=

# ─── GOOGLE AI STUDIO (Nano Banana / Gemini 2.5 Flash Image) ───  [K]
# https://aistudio.google.com/apikey  (billing required)
GOOGLE_AI_API_KEY=

# ─── LUMA AI (Dream Machine — b-roll cinematográfico) ──  [K]
# https://lumalabs.ai/dream-machine/api  (pre-load credits)
LUMA_API_KEY=

# ─── FAL.ai (opcional, fallback más barato para imágenes) ─  [K]
FAL_KEY=

# ─── Visual assets pipeline ─────────────────────────────  [K]
VISUAL_ASSETS_BUCKET=visual-assets
ASSETS_ENABLED=true

# ─── APP ─────────────────────────────────────────────────  [W]
# Production: set NEXT_PUBLIC_APP_URL to your Vercel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── IG PUBLISHER (inter-service auth) ──────────────────  [K] [I]
# Used by the worker to sign requests to the ig-publisher when handling
# `virus/carousel.publish.requested` events. Both services must agree on the secret.
# (The web app dispatches the event but never calls the publisher directly.)
IG_PUBLISHER_HMAC_SECRET=
IG_PUBLISHER_ADMIN_TOKEN=
# Worker → publisher URL (Railway internal hostname in prod, e.g. http://ig-publisher.railway.internal:8000)
IG_PUBLISHER_URL=

# ─── SENTRY (optional) ──────────────────────────────────  [W] [K]
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── WORKER (Railway only) ──────────────────────────────  [K]
# Railway injects PORT automatically; server.ts falls back to WORKER_PORT then 3001.
# WORKER_PORT=3001
