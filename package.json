{
  "name": "virus",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:full": "concurrently --names \"apps,inngest\" --prefix-colors \"cyan,green\" \"turbo dev\" \"npx inngest-cli@latest dev --no-discovery -u http://localhost:3002/api/inngest\"",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}
