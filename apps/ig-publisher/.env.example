# ─── Supabase (service role; NEVER expose this key to clients) ───
SUPABASE_URL=https://jdkjnaivkucnpvmwuraz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── HMAC shared secret (web/worker ↔ publisher) ────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 hex chars. Set the same value on Vercel as
# IG_PUBLISHER_HMAC_SECRET.
IG_PUBLISHER_HMAC_SECRET=

# ─── Logging / runtime ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json   # 'json' for production, 'console' for local dev
PORT=8000
ENVIRONMENT=development   # development | staging | production

# ─── Optional ───────────────────────────────────────────────────
# Where to download carousel images for instagrapi to upload from.
# /tmp is fine on Railway (ephemeral, cleaned after each publish).
DOWNLOAD_DIR=/tmp/ig-publisher

# Sentinel that protects /admin/* endpoints. If unset, admin endpoints
# are disabled entirely. Should be different from IG_PUBLISHER_HMAC_SECRET.
IG_PUBLISHER_ADMIN_TOKEN=
